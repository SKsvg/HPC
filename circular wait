#include <stdio.h>
#include <mpi.h>

int main(int argc, char* argv[])
{
    int rank;

    MPI_Init(&argc, &argv);

    MPI_Comm_rank(MPI_COMM_WORLD, &rank);

    int a = 10*rank;
    int b ;

    printf("Rank%d: sending...\n",rank);
    MPI_Send(&a, 1, MPI_INT, (rank+1)%npes, 1, MPI_COMM_WORLD);
    printf("Rank%d: sending completed\n",rank);
    MPI_Recv(&b, 1, MPI_INT, (rank-1+npes)%npes, 1, MPI_COMM_WORLD,
    MPI_STATUS_IGNORE);
    
    printf("Rank%d: Recieved...%d\n",rank,b);

    MPI_Finalize();

    return 0;
}
