///no deadlock

#include <stdio.h>
#include <mpi.h>

int main(int argc, char *argv[])
{
    MPI_Init(&argc, &argv);

    int rank, size;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    int send_data = rank + 100;    // each process sends rank + 100
    int recv_data;

    // Determine neighbours in the ring
    int left = (rank - 1 + size) % size;  // neighbour to receive from
    int right = (rank + 1) % size;        // neighbour to send to

    // Perform simultaneous send and receive
    MPI_Sendrecv(&send_data, 1, MPI_INT, right, 0,
                 &recv_data, 1, MPI_INT, left, 0,
                 MPI_COMM_WORLD, MPI_STATUS_IGNORE);

    printf("Process %d sent %d to process %d "
           "and received %d from process %d\n",
           rank, send_data, right, recv_data, left);

    MPI_Finalize();

    return 0;
}
